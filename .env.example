# ==============================================================================
# Agent-Parkour Environment Configuration (.env.example)
# ==============================================================================
# Agent-Parkour는 기본적으로 LLM API 호출 없이 100% 결정론적(Deterministic) AST 파서로 동작합니다.
# 아래 API 키를 설정하면 지능형 규칙 분할(Semantic Decompose), 
# 트리거 자동 생성, 3-Way 충돌 스마트 병합 및 Promptfoo 품질 평가를 활성화할 수 있습니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI 증강 모드 활성화 여부 (true / false)
# ------------------------------------------------------------------------------
PARKOUR_AI_ENABLED=true
PARKOUR_AI_PROVIDER=gemini # [gemini | claude | openai | ollama | mock]
PARKOUR_AI_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 2. LLM Provider API Keys (선택 사항)
# ------------------------------------------------------------------------------
# Google Gemini (Antigravity & Gemini CLI 최적화)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Claude Code 최적화)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4o / o-series)
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM / Ollama (API 비용 0원, 로컬 오프라인 실행)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b

# ------------------------------------------------------------------------------
# 3. Promptfoo 회귀 테스트 및 품질 평가 설정
# ------------------------------------------------------------------------------
PROMPTFOO_CACHE_ENABLED=true
PROMPTFOO_MAX_CONCURRENCY=4
